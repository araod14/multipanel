# --- Control Plane settings ---
# Copy to .env and fill in. NEVER commit the real .env.

# Database for the control plane itself (NOT the per-user trade DBs)
CP_DATABASE_URL=sqlite:///./control_plane.sqlite

# JWT signing secret for the control plane's OWN tokens (admin/user sessions).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
CP_JWT_SECRET=change-me-to-a-long-random-value
CP_JWT_ACCESS_TTL_MINUTES=30
CP_JWT_REFRESH_TTL_DAYS=7

# Fernet master key used to encrypt exchange/api secrets at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CP_FERNET_KEY=change-me-44-char-fernet-key=

# Public origin of the control plane (used for CORS_origins injected into each bot config)
CP_PUBLIC_ORIGIN=https://localhost

# Freqtrade image and docker network for the per-user bot containers
CP_FREQTRADE_IMAGE=freqtradeorg/freqtrade:stable
CP_BOT_NETWORK=control-plane-bots
# Host directory where per-user user_data volumes are stored
CP_BOT_DATA_ROOT=/srv/control-plane/bots

# First admin bootstrapped on startup if no admin exists
CP_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
CP_BOOTSTRAP_ADMIN_PASSWORD=change-me-on-first-login
