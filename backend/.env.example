# --- Control Plane settings ---
# Copy to .env and fill in. NEVER commit the real .env.

# Database for the control plane itself (NOT the per-user trade DBs)
CP_DATABASE_URL=sqlite:///./control_plane.sqlite

# JWT signing secret for the control plane's OWN tokens (admin/user sessions).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
CP_JWT_SECRET=change-me-to-a-long-random-value
CP_JWT_ACCESS_TTL_MINUTES=30
CP_JWT_REFRESH_TTL_DAYS=7

# Fernet master key used to encrypt exchange/api secrets at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CP_FERNET_KEY=change-me-44-char-fernet-key=

# Public origin of the control plane (used for CORS_origins injected into each bot config)
CP_PUBLIC_ORIGIN=https://localhost

# Freqtrade image and docker network for the per-user bot containers
CP_FREQTRADE_IMAGE=freqtradeorg/freqtrade:stable
CP_BOT_NETWORK=control-plane-bots
# Host directory where per-user user_data volumes are stored
CP_BOT_DATA_ROOT=/srv/control-plane/bots

# Fallback exchange for bots with no stored credentials (dry-run only). Real trading
# always uses the exchange of the user's stored credential, which must be in the
# allowlist (see services/exchange_creds.py SUPPORTED_EXCHANGES).
# Binance blocks API access by SERVER country (Canada, Malaysia, Netherlands, US);
# verify from the host that will run the bots: curl https://api.binance.com/api/v3/ping
CP_DEFAULT_EXCHANGE=binance

# --- Live (real-money) guard rails ---
# Hard ceiling on the TOTAL stake a live bot may deploy (also injected into the bot
# config as available_capital, so Freqtrade enforces it too).
CP_LIVE_MAX_CAPITAL=25.0
# Floor for a live per-trade stake. Below a pair's minimum Freqtrade silently never trades.
CP_LIVE_MIN_STAKE=10.0
# Verify exchange API keys against the exchange before storing them. Keep true.
CP_VALIDATE_EXCHANGE_KEYS=true

# --- Trading-state reconciliation ---
# Seconds between passes that re-start bots whose owner had them trading but whose
# container came back idle (Freqtrade boots with initial_state: stopped). 0 disables it.
CP_TRADING_RECONCILE_INTERVAL=60

# --- Public results page (NO authentication) ---
# Serves an anonymous rollup of every account's results at GET /api/public/results.
# Set to false to take the page down instantly.
CP_PUBLIC_RESULTS_ENABLED=true
# Seconds a collected rollup is reused, so an anonymous burst is one fan-out, not N.
CP_PUBLIC_RESULTS_TTL=20.0
# Per-IP requests per minute before the endpoint answers 429.
CP_PUBLIC_RESULTS_RATE_LIMIT=30

# First admin bootstrapped on startup if no admin exists
CP_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
CP_BOOTSTRAP_ADMIN_PASSWORD=change-me-on-first-login
